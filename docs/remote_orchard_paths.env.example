# Copy to configs/paths.env and replace these local paths. Do not commit paths.env.
export ORCHARD_ROOT="/absolute/path/to/orchard_project"
export ORCHARD_RAW_DATA="$ORCHARD_ROOT/datasets"
export ORCHARD_IMAGES="$ORCHARD_ROOT/images"
export ORCHARD_MODELS="$ORCHARD_ROOT/models"
export ORCHARD_OUTPUTS="$ORCHARD_ROOT/outputs"
